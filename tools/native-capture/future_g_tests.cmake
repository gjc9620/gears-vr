# Private CPU verification targets, independent from the default Native option.
if(MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/future-g-cases")
    foreach(FUTURE_G_VARIANT IN ITEMS On Off)
        set(FG_TEST FutureGHost${FUTURE_G_VARIANT}Test)
        add_executable(${FG_TEST} future_g_test.cpp)
        set_property(TARGET ${FG_TEST} PROPERTY CXX_STANDARD 17)
        set_property(TARGET ${FG_TEST} PROPERTY MSVC_RUNTIME_LIBRARY MultiThreaded)
        target_compile_options(${FG_TEST} PRIVATE /O2 /W4 /WX /EHsc /UNDEBUG)
        if(FUTURE_G_VARIANT STREQUAL "On")
            target_compile_definitions(${FG_TEST} PRIVATE GEARS_COVER_FUTURE_G_OBSERVER=1)
        else()
            target_compile_definitions(${FG_TEST} PRIVATE GEARS_COVER_FUTURE_G_OBSERVER=0)
        endif()
    endforeach()
    foreach(FG_CASE IN ITEMS normal nonunit nan wrong-ra wrong-node wrong-bone wrong-mesh wrong-ordinal wrong-thread wrong-compose duplicate seh cpp stop unknown-end unknown-compose metadata entry caller since during counter-ownership copy-end begin-failed)
        add_test(NAME FutureGHost-${FG_CASE} COMMAND FutureGHostOnTest ${FG_CASE} "${CMAKE_CURRENT_BINARY_DIR}/future-g-cases")
    endforeach()
    add_test(NAME FutureGHost-Off COMMAND FutureGHostOffTest off "${CMAKE_CURRENT_BINARY_DIR}/future-g-cases")
    add_executable(FutureGThunksTest cover_future_g_thunks_test.cpp cover_future_g_thunks.asm cover_body_thunks.asm cover_body_thunks_test.asm)
    set_property(TARGET FutureGThunksTest PROPERTY CXX_STANDARD 17)
    set_property(TARGET FutureGThunksTest PROPERTY MSVC_RUNTIME_LIBRARY MultiThreaded)
    target_compile_options(FutureGThunksTest PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:/O2;/W4;/WX;/EHsc;/UNDEBUG>")
    add_test(NAME FutureGThunksTest COMMAND FutureGThunksTest)
    add_executable(MinHookFutureGTest minhook_future_g_test.cpp)
    set_property(TARGET MinHookFutureGTest PROPERTY CXX_STANDARD 17)
    set_property(TARGET MinHookFutureGTest PROPERTY MSVC_RUNTIME_LIBRARY MultiThreaded)
    target_compile_options(MinHookFutureGTest PRIVATE /O2 /W4 /WX /EHsc /UNDEBUG)
    target_link_libraries(MinHookFutureGTest PRIVATE minhook)
    set(GEARS_FUTURE_G_TEST_IMAGE "" CACHE FILEPATH "Ignored actual getter32 fixture, CPU only")
    if(GEARS_FUTURE_G_TEST_IMAGE)
        if(GEARS_COVER_FUTURE_G_OBSERVER)
            set(FG_TEST_CAP on)
        else()
            set(FG_TEST_CAP off)
        endif()
        add_test(NAME MinHookFutureGTest COMMAND MinHookFutureGTest ${FG_TEST_CAP} "${GEARS_FUTURE_G_TEST_IMAGE}")
    endif()
endif()
