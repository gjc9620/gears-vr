    void load_generic(){generic_info_={};if(!generic_model())return;auto stem=model_.substr(0,model_.size()-4);generic_info_=Json::parse(asset(stem+".parts.json"));auto const& groups=generic_info_.at("groups");generic_meshes_.resize(groups.size());generic_offset_.assign(groups.size(),{});generic_angles_.assign(groups.size(),{});generic_world_.assign(groups.size(),{});for(unsigned i=0;i<groups.size();++i){std::string name=groups[i].value("replacement_mesh",groups[i].at("mesh").get<std::string>());if(!name.empty())generic_meshes_[i]=renderer_.load_glb(name);}std::string rest=generic_info_.at("rest_mesh");if(!rest.empty())generic_rest_=renderer_.load_glb(rest);if(generic_info_.contains("practice")){std::string ammo=generic_info_["practice"].value("ammo_mesh",std::string{});if(!ammo.empty())ammo_mesh_=renderer_.load_glb(ammo);}}
