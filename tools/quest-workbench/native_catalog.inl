    Volume ammo_pickup_bounds(Frame const& f)const{auto const& mesh=generic_model()?ammo_mesh_:components_[3];V lo{1e9,1e9,1e9},hi{-1e9,-1e9,-1e9};for(auto const& a:mesh.vertices){lo={std::min(lo.x,double(a.x)),std::min(lo.y,double(a.y)),std::min(lo.z,double(a.z))};hi={std::max(hi.x,double(a.x)),std::max(hi.y,double(a.y)),std::max(hi.z,double(a.z))};}Volume box{};box.shape="box";auto center=mesh.vertices.empty()?parts_[2].volume.local.position:mul(add(lo,hi),.5);box.half=mesh.vertices.empty()?V{.12,.12,.12}:add(mul(sub(hi,lo),.5),{.075,.075,.075});P delta=current_part_delta(2,f);if(generic_model())delta=compose(delta,{vector(generic_info_.at("practice").at("feed")),{}});box.local=compose(delta,{center,{}});return box;}
