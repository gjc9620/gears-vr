--- /dev/null
+++ b/src/swapchain_handles.h
@@ -0,0 +1,39 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <limits>
+#include <type_traits>
+#include <utility>
+
+namespace simxr {
+// One runtime-global allocator; never reset on erase, instance or session end.
+// Zero marks exhaustion. Issuing UINTPTR_MAX is allowed, but never wraps to 1/2.
+class SwapchainHandles {
+    std::atomic<std::uintptr_t> next_;
+public:
+    explicit SwapchainHandles(std::uintptr_t first=2) noexcept : next_(first>=2?first:0) {}
+    bool allocate(std::uintptr_t& result) noexcept {
+        auto current=next_.load(std::memory_order_relaxed);
+        while(current) {
+            const auto following=current==(std::numeric_limits<std::uintptr_t>::max)()?0:current+1;
+            if(next_.compare_exchange_weak(current,following,std::memory_order_relaxed)) {
+                result=current;return true;
+            }
+        }
+        return false;
+    }
+};
+
+// Preserve the caller's backend resources on a collision/allocation exception.
+// Allocate an empty map node first: emplace(key,move(candidate)) could consume
+// Vulkan/GL raw handles before a failing node allocation/rehash destroys them.
+// Map access keeps the runtime's existing caller synchronization requirements.
+template<class Map>
+bool InsertSwapchain(Map& map,typename Map::key_type handle,typename Map::mapped_type& candidate) {
+    static_assert(std::is_nothrow_move_assignable_v<typename Map::mapped_type>);
+    const auto inserted=map.try_emplace(handle);
+    if(!inserted.second)return false;
+    inserted.first->second=std::move(candidate);
+    return true;
+}
+}
