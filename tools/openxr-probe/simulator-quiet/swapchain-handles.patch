+++ b/tests/swapchain_handles_tests.cpp
@@ -0,0 +1,86 @@
+#include "swapchain_handles.h"
+#include <algorithm>
+#include <cstdio>
+#include <memory>
+#include <new>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#define CHECK(value) do{if(!(value)){std::printf("FAILED line %d: %s\n",__LINE__,#value);return 1;}++checks;}while(0)
+struct Resource {unsigned width{},height{};int* live{};
+    Resource(unsigned w,unsigned h,int& count):width(w),height(h),live(&count){++*live;}
+    ~Resource(){--*live;}
+};
+struct Chain {std::unique_ptr<Resource> texture;};
+struct AllocationFailure {int remaining{};};
+template<class T> struct FailingAllocator {
+    using value_type=T;AllocationFailure* failure{};
+    explicit FailingAllocator(AllocationFailure* f=nullptr):failure(f){}
+    template<class U> FailingAllocator(FailingAllocator<U> const& other):failure(other.failure){}
+    T* allocate(std::size_t n){if(failure&&failure->remaining>=0&&failure->remaining--==0)throw std::bad_alloc();
+        return std::allocator<T>{}.allocate(n);}
+    void deallocate(T* p,std::size_t n){std::allocator<T>{}.deallocate(p,n);}
+    template<class U> bool operator==(FailingAllocator<U> const& other)const{return failure==other.failure;}
+    template<class U> bool operator!=(FailingAllocator<U> const& other)const{return !(*this==other);}
+};
+int main(){
+    unsigned checks=0;int live=0;simxr::SwapchainHandles handles;
+    std::unordered_map<std::uintptr_t,Chain> chains;
+    auto create=[&](unsigned width,unsigned height,std::uintptr_t& handle){
+        if(!handles.allocate(handle))return false;
+        Chain candidate;candidate.texture=std::make_unique<Resource>(width,height,live);
+        return simxr::InsertSwapchain(chains,handle,candidate);
+    };
+    std::uintptr_t menu{},replacement{},left{},right{};
+    CHECK(create(1920,764,menu)&&menu==2);
+    CHECK(create(1920,1080,replacement)&&replacement==3);
+    CHECK(chains.erase(menu)==1&&live==1);
+    CHECK(create(960,1080,left)&&left==4);
+    CHECK(create(960,1080,right)&&right==5&&right!=left);
+    CHECK(chains.at(replacement).texture->width==1920&&chains.at(replacement).texture->height==1080);
+    CHECK(chains.at(left).texture->width==960&&chains.at(left).texture->height==1080);
+    CHECK(chains.at(right).texture->width==960&&chains.at(right).texture->height==1080);
+    CHECK(chains.at(left).texture.get()!=chains.at(right).texture.get());
+    // Failed publication must not overwrite the old chain or consume the new
+    // backend allocation, so the caller can run Vulkan/GL-specific cleanup.
+    {Chain duplicate;duplicate.texture=std::make_unique<Resource>(1280,720,live);
+        auto* original=chains.at(replacement).texture.get();
+        CHECK(!simxr::InsertSwapchain(chains,replacement,duplicate));
+        CHECK(duplicate.texture&&duplicate.texture->width==1280&&chains.at(replacement).texture.get()==original);
+        CHECK(live==4);
+    }
+    CHECK(live==3);
+    for(int fail_after=0;fail_after<2;++fail_after){
+        using Entry=std::pair<const std::uintptr_t,Chain>;
+        using Map=std::unordered_map<std::uintptr_t,Chain,std::hash<std::uintptr_t>,std::equal_to<std::uintptr_t>,FailingAllocator<Entry>>;
+        AllocationFailure failure{-1};Map failing(0,std::hash<std::uintptr_t>{},std::equal_to<std::uintptr_t>{},FailingAllocator<Entry>{&failure});
+        // Fill the initial buckets so publication allocates both a node and a
+        // rehash array. Exercise failure at either actual STL allocation.
+        const auto previous_size=failing.bucket_count();
+        for(std::size_t i=0;i<previous_size;++i)failing.try_emplace(100+i);
+        Chain candidate;candidate.texture=std::make_unique<Resource>(640,360,live);bool threw=false;
+        failure.remaining=fail_after;
+        try{simxr::InsertSwapchain(failing,7,candidate);}catch(std::bad_alloc const&){threw=true;}
+        CHECK(threw&&candidate.texture&&candidate.texture->width==640&&live==4&&failing.size()==previous_size);
+        failure.remaining=-1;
+        CHECK(simxr::InsertSwapchain(failing,7,candidate)&&!candidate.texture&&failing.at(7).texture->width==640);
+    }
+    CHECK(live==3);
+    chains.clear();CHECK(live==0);
+    std::uintptr_t next{};CHECK(handles.allocate(next)&&next==6); // No reset on complete teardown.
+    const auto maximum=(std::numeric_limits<std::uintptr_t>::max)();
+    simxr::SwapchainHandles end(maximum-1);
+    CHECK(end.allocate(next)&&next==maximum-1);
+    CHECK(end.allocate(next)&&next==maximum);
+    for(unsigned i=0;i<8;++i)CHECK(!end.allocate(next)&&next==maximum);
+    simxr::SwapchainHandles invalid0(0),invalid1(1);
+    CHECK(!invalid0.allocate(next)&&!invalid1.allocate(next));
+    simxr::SwapchainHandles parallel;std::vector<std::thread> threads;
+    std::vector<std::uintptr_t> allocated(8000);
+    for(unsigned t=0;t<8;++t)threads.emplace_back([&,t](){for(unsigned i=0;i<1000;++i){
+        std::uintptr_t value{};parallel.allocate(value);allocated[t*1000+i]=value;}});
+    for(auto& thread:threads)thread.join();std::sort(allocated.begin(),allocated.end());
+    for(unsigned i=0;i<allocated.size();++i)CHECK(allocated[i]==std::uintptr_t(i)+2);
+    std::printf("swapchain_handles: %u checks passed (menu replacement, dimensions, collision/exception ownership, exhaustion, concurrent IDs)\n",checks);
+}
