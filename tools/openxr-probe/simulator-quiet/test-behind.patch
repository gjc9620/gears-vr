--- /dev/null
+++ b/src/preview_window_policy.h
@@ -0,0 +1,19 @@
+#pragma once
+#include <windows.h>
+#include <string_view>
+
+namespace simxr {
+inline bool WindowsBehindEnabled(std::string_view value) { return value == "1"; }
+
+// Called only for this runtime's own preview at explicit show/restore boundaries.
+// Position callback intentionally has no geometry arguments: preserve location/size.
+template<class Position, class Show>
+inline bool PresentPreviewWindow(HWND hwnd, bool behind, int legacyCommand,
+                                 Position position, Show show) {
+    if (!behind) { show(hwnd, legacyCommand); return true; }
+    constexpr UINT flags = SWP_NOACTIVATE | SWP_NOMOVE | SWP_NOSIZE;
+    if (!position(hwnd, HWND_BOTTOM, flags)) return false;
+    show(hwnd, SW_SHOWNA);
+    return true;
+}
+} // namespace simxr
--- /dev/null
+++ b/tests/preview_window_policy_tests.cpp
@@ -0,0 +1,41 @@
+#include "preview_window_policy.h"
+#include <cstdio>
+#include <vector>
+#include <initializer_list>
+struct Event { bool position; HWND window; HWND after; unsigned value; };
+int main() {
+    int checks=0, failures=0;
+    const auto check=[&](bool ok){ ++checks; if(!ok) ++failures; };
+    for(const auto value : {"", "0", "true", "01", "1 ", " 1", "11"})
+        check(!simxr::WindowsBehindEnabled(value));
+    check(simxr::WindowsBehindEnabled("1"));
+    HWND own=reinterpret_cast<HWND>(static_cast<UINT_PTR>(123));
+    for(bool behind : {false,true}) for(int command : {SW_SHOW,SW_SHOWNA,SW_SHOWNOACTIVATE,SW_RESTORE}) {
+        std::vector<Event> events;
+        const bool presented=simxr::PresentPreviewWindow(own,behind,command,
+            [&](HWND h,HWND after,UINT flags){events.push_back({true,h,after,flags}); return true;},
+            [&](HWND h,int show){events.push_back({false,h,nullptr,static_cast<unsigned>(show)});});
+        check(presented);
+        for(const auto& event:events) check(event.window==own);
+        if(!behind) {
+            check(events.size()==1 && !events[0].position && events[0].value==command);
+            continue;
+        }
+        check(events.size()==2);
+        check(events[0].position && events[0].after==HWND_BOTTOM);
+        check(events[0].value==(SWP_NOACTIVATE|SWP_NOMOVE|SWP_NOSIZE));
+        check(!(events[0].value&(SWP_SHOWWINDOW|SWP_HIDEWINDOW|SWP_NOZORDER)));
+        check(!events.back().position && events.back().value==SW_SHOWNA);
+    }
+    for(bool behind : {false,true}) for(int command : {SW_SHOW,SW_SHOWNA,SW_SHOWNOACTIVATE,SW_RESTORE}) {
+        int positioned=0, shown=0;
+        const bool presented=simxr::PresentPreviewWindow(own,behind,command,
+            [&](HWND,HWND,UINT){++positioned; return false;},
+            [&](HWND,int){++shown;});
+        check(presented==!behind);
+        check(positioned==(behind?1:0));
+        check(shown==(behind?0:1));
+    }
+    std::printf("preview policy: %d checks, %d failures\n",checks,failures);
+    return failures?1:0;
+}
