diff --git a/src/focus_policy.h b/src/focus_policy.h
new file mode 100644
index 0000000..ad99a85
--- /dev/null
+++ b/src/focus_policy.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <openxr/openxr.h>
+#include <string_view>
+
+namespace simxr {
+
+// Explicit automation opt-in; missing and all other values retain OS focus policy.
+inline bool ForceFocusEnabled(std::string_view value) {
+    return value == "1";
+}
+
+inline bool PreviewInputFocused(bool osFocused, bool forceFocus, XrSessionState state) {
+    return osFocused || (forceFocus &&
+        (state == XR_SESSION_STATE_VISIBLE || state == XR_SESSION_STATE_FOCUSED));
+}
+
+// Return UNKNOWN to leave the session unchanged. Only the VISIBLE/FOCUSED
+// pair participates: activation must never restart a stopping/ended session.
+inline XrSessionState ActivationTransition(bool osFocused, bool forceFocus,
+                                          XrSessionState state) {
+    const bool focused = PreviewInputFocused(osFocused, forceFocus, state);
+    if (focused && state == XR_SESSION_STATE_VISIBLE) return XR_SESSION_STATE_FOCUSED;
+    if (!focused && state == XR_SESSION_STATE_FOCUSED) return XR_SESSION_STATE_VISIBLE;
+    return XR_SESSION_STATE_UNKNOWN;
+}
+
+} // namespace simxr
diff --git a/tests/focus_policy_tests.cpp b/tests/focus_policy_tests.cpp
new file mode 100644
index 0000000..6cc2452
--- /dev/null
+++ b/tests/focus_policy_tests.cpp
@@ -0,0 +1,39 @@
+#include "focus_policy.h"
+
+#include <cstdio>
+#include <initializer_list>
+
+int main() {
+    int checks = 0;
+    int failures = 0;
+    const auto check = [&](bool condition) {
+        ++checks;
+        if (!condition) ++failures;
+    };
+    for (const auto value : {"", "0", "true", "01", "1 ", " 1", "2"})
+        check(!simxr::ForceFocusEnabled(value));
+    check(simxr::ForceFocusEnabled("1"));
+
+    for (int raw = XR_SESSION_STATE_UNKNOWN; raw <= XR_SESSION_STATE_EXITING; ++raw) {
+        const auto state = static_cast<XrSessionState>(raw);
+        for (const bool osFocused : {false, true}) {
+            for (const bool forceFocus : {false, true}) {
+                const bool active = state == XR_SESSION_STATE_VISIBLE || state == XR_SESSION_STATE_FOCUSED;
+                const bool effective = osFocused || (forceFocus && active);
+                check(simxr::PreviewInputFocused(osFocused, forceFocus, state) == effective);
+                const auto next = simxr::ActivationTransition(osFocused, forceFocus, state);
+                if (state == XR_SESSION_STATE_VISIBLE && effective)
+                    check(next == XR_SESSION_STATE_FOCUSED);
+                else if (state == XR_SESSION_STATE_FOCUSED && !effective)
+                    check(next == XR_SESSION_STATE_VISIBLE);
+                else
+                    check(next == XR_SESSION_STATE_UNKNOWN);
+            }
+        }
+    }
+    // Repeat inactive notifications do not queue duplicate transitions.
+    check(simxr::ActivationTransition(false, true, XR_SESSION_STATE_VISIBLE) == XR_SESSION_STATE_FOCUSED);
+    check(simxr::ActivationTransition(false, true, XR_SESSION_STATE_FOCUSED) == XR_SESSION_STATE_UNKNOWN);
+    std::printf("focus policy: %d checks, %d failures\n", checks, failures);
+    return failures ? 1 : 0;
+}
