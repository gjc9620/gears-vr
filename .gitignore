/assets/*
!/assets/weapon-6dof/
/assets/weapon-6dof/*
!/assets/weapon-6dof/README.md
!/assets/weapon-6dof/gnasher-round.glb

# Third-party packages and local builds under our tools directory.
/tools/package-inspector/python-libs/
/tools/package-inspector/uelib-1.12.0/
/tools/package-inspector/unsafe/
/tools/third-party/
/tools/native-capture/build*/
/tools/game-io/build*/
/tools/playground/build*/
/tools/gpu-capture/build*/
/tools/openxr-probe/build*/
