+"""One ordinary empty reload: prove no automatic refill, replace, close, fire.
+
+No reserve-exhaustion tail, inventory setter, game function call or input retry.
+The existing core spends six; genuine fire drains the remaining loaded72 only.
+"""
+import json
+from hammerburst_count_snapshot import sample as counts
+from hammerburst_supply_boundary_chain import drain
+from hammerburst_reload_chain import run as reload_run
+
+
+def run(c):
+    g = c.g
+    root = g.directory
+    destination = root / 'hammerburst-empty-reload.json'
+    data = dict(game=g.game, checks={}, gameplay_setters=False,
+                scope='L72/R78 -> L0/R78 -> one empty trigger -> ordinary replacement -> L78/R0 -> six shots L72/R0',
+                reserve_exhaustion_attempted=False, physical_headset_accepted=False)
+
+    def save():
+        destination.write_text(json.dumps(data, indent=2), encoding='utf-8')
+
+    try:
+        initial = counts(c, 'empty_reload_initial')
+        data['initial'] = initial
+        assert initial['loaded'] == 72 and initial['reserve'] == initial['capacity'] == 78
+        assert not initial['infinite_reserve']
+        weapon = int(initial['weapon'], 16)
+        bound = [r for r in c.records('lancer_manual_auto_reload_bound')
+                 if int(r.get('weapon', '0'), 16) == weapon]
+        data['manual_veto_binding'] = bound
+        save()
+        assert bound, 'No actual CanReload veto binding for this HB; stop before drain'
+        data['drain_loaded_only'] = {}
+        drain(c, 'empty_reload_drain', evidence=data['drain_loaded_only'], persist=save)
+        empty = counts(c, 'empty_reload_before_empty_trigger')
+        data['empty_before_trigger'] = empty
+        save()
+        assert empty['weapon'] == initial['weapon']
+        assert empty['loaded'] == 0 and empty['reserve'] == empty['capacity'] == 78
+        assert not empty['infinite_reserve'], 'Empty boundary changed before its real trigger'
+        shot_start = len(c.records('native_lancer_shot_trajectory'))
+        c.live()
+        g.pad(1, wait=.35, trigger=1)
+        g.pad(1, wait=.6)
+        after_empty = counts(c, 'empty_reload_after_empty_trigger')
+        data['empty_after_trigger'] = after_empty
+        data['empty_trigger_shots'] = c.records('native_lancer_shot_trajectory')[shot_start:]
+        data['manual_veto_consumption'] = c.records('lancer_manual_auto_reload')
+        save()
+        assert all(empty[k] == after_empty[k] for k in
+                   ('weapon', 'loaded', 'used', 'reserve', 'capacity', 'infinite_reserve', 'active_reload_bonus_shots'))
+        assert not data['empty_trigger_shots'], 'Empty trigger produced a shot'
+        assert any(int(r.get('blocked', '0')) > 0 for r in data['manual_veto_consumption']), \
+            'No actual non-action CanReload veto consumption receipt'
+        data['checks']['empty_trigger_preserves_L0_R78_no_shot'] = True
+        target = root / 'ordinary_empty_replacement'
+        target.mkdir()
+        g.directory = target
+        try:
+            reload_run(c, require_empty_original_begin=True)
+        finally:
+            g.directory = root
+        replacement = json.loads((target / 'hammerburst-replacement.json').read_text())
+        data['replacement'] = replacement
+        save()
+        assert 'error' not in replacement
+        assert replacement['before']['loaded'] == 0 and replacement['before']['reserve'] == 78
+        assert replacement['after']['loaded'] == 78 and replacement['after']['reserve'] == 0
+        assert replacement['after_return_fire']['loaded'] == 72 and replacement['after_return_fire']['reserve'] == 0
+        assert len(replacement['shots']) == 6
+        data['checks']['ordinary_empty_reload_close_and_six_return_fire'] = True
+    except BaseException as error:
+        data['error'] = repr(error)
+        raise
+    finally:
+        g.directory = root
+        save()
