{
  "schema": "gearsvr.offline-calibration-plan.v1",
  "runtime_enabled": false,
  "purpose": "Authoring/measurement contract, not runtime config. Null means not measured; zero/identity is not a substitute.",
  "coordinate_policy": {
    "authored_glb": "metres, asset-local markers; provisional authoring scale",
    "original_mesh": "original raw bind-space; do not assume raw unit equals current game unit",
    "runtime": "one explicit scale/axis conversion through current body/reference basis",
    "hand_pose": "current mainline controller grip; do not duplicate camera/recenter offsets"
  },
  "required_receipt_fields": [
    "game_executable_sha256",
    "source_mesh_sha256",
    "asset_content_sha256",
    "world_generation",
    "weapon_class",
    "weapon_instance_identity",
    "component_identity",
    "mesh_to_component",
    "component_to_weapon",
    "grip_to_weapon",
    "units_per_metre",
    "axis_mapping",
    "reference_generation",
    "basis_generation",
    "measurement_method",
    "measurement_time",
    "evidence_paths"
  ],
  "procedure": [
    "Compare exact class, mesh hash and original parent/bind hierarchy to evidence before using any marker.",
    "Read current component scale/bind transforms through the certified game-thread reader; combine once with authored local markers.",
    "Capture primary/support grips and insertion plane/axis in weapon-local coordinates, not eye/world coordinates.",
    "Check endpoint and swept clearances at original closed/open states; visual mesh, hand interaction volume and projectile origin remain distinct.",
    "Use Boltok six-slot assembly for offline fit only; validate original Object03 pivot and original scale before runtime placement.",
    "Save a complete identity-bound receipt; missing/changed hash, units or basis disables only the uncalibrated action and reports the field.",
    "Owner hand comfort and actual stereo/depth are later runtime acceptance, not proof from these files."
  ],
