+  p=Path(item['path']);assert not p.is_symlink()
+  row=dict(path=str(p),exists=p.exists(),sha256=sha(p) if p.exists() else None,public_read_only=item['public_read_only'])
+  if p.exists():
+   assert p.is_file();backup=folder/(str(n)+'-'+p.name);shutil.copy2(p,backup)
+   assert sha(backup)==row['sha256'];row['backup']=str(backup)
+  rows.append(row)
+ result={'files':rows,'scope':'Immediate exact owned-window baseline; public item read-only'}
+ (folder/'baseline.json').write_text(json.dumps(result,indent=2))
+ return result
+
+def restore(baseline,root):
+ # Caller must first prove its exact runtime's normal cleanup and fresh idle.
+ # No PID/ownership inference or runtime action belongs in this helper.
+ root=Path(root).resolve()
+ for row in baseline['files']:
+  p=Path(row['path']);assert not p.is_symlink()
+  if row['public_read_only']:
+   assert p.exists()==row['exists'] and (sha(p) if p.exists() else None)==row['sha256'],'Public changed: no public write'
+  else:
+   assert p.resolve().is_relative_to(root)
+   if row['exists']:assert sha(Path(row['backup']))==row['sha256']
+   elif p.exists():assert p.is_file() and p.resolve().is_relative_to(root/'analysis/instances/solo-m1-1028d')
+ # Validate the whole set before writing any file.
+ for row in baseline['files']:
+  if row['public_read_only']:continue
+  p=Path(row['path'])
+  if row['exists']:
+   if not p.exists() or sha(p)!=row['sha256']:shutil.copy2(row['backup'],p)
+  elif p.exists():p.unlink()
+ checks=[p.exists()==row['exists'] and (sha(p) if p.exists() else None)==row['sha256'] for row in baseline['files'] for p in [Path(row['path'])]]
+ assert all(checks);return checks
