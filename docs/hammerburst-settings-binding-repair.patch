+def validate(selection,root,check_exe=True):
+ root=Path(root).resolve();instance=root/'analysis/instances/solo-m1-1028d'
+ assert Path(selection['game_path']).resolve()==EXE.resolve()
+ assert selection['game_sha256']==EXE_SHA
+ assert Path(selection['settings_path']).resolve()==instance/'LocalAppData/Coalition/WarGame/Config/76561197960271872EngineUserSettings.ini'
+ # Exact current owner selection, not a broad alternative-path fallback.
+ if check_exe:assert EXE.is_file() and sha(EXE)==EXE_SHA
+ return True
+
+def config_bytes(original,selection,root):
+ validate(selection,root,False)
+ value=json.loads(original.decode('utf-8-sig'))
+ value['game_path']=selection['game_path']
+ bindings=value.get('game_settings_paths',{})
+ if not isinstance(bindings,dict) or any(not isinstance(k,str) or not Path(k).is_absolute() or not isinstance(v,str) or not Path(v).is_absolute() for k,v in bindings.items()):
+  raise ValueError('game_settings_paths must map absolute game paths to settings files')
+ selected=str(Path(selection['game_path']).resolve()).casefold()
+ # Replace only aliases of this owner-selected installation; preserve all
+ # other installations. Use the same normalization as graphics_policy.locate.
+ value['game_settings_paths']={k:v for k,v in bindings.items() if str(Path(k).resolve()).casefold()!=selected}
+ value['game_settings_paths'][str(Path(selection['game_path']).resolve())]=selection['settings_path']
+ return json.dumps(value,indent=2).encode('utf-8')
+
+def capture(paths,folder):
