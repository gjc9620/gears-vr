+            rejection_prefixes=('native_hammerburst_continuation_rejected','native_hammerburst_release_rejected')
+            rejection_offsets={p:len(c.records(p)) for p in rejection_prefixes}
             c.live();g.pad(1,wait=.35,trigger=1);g.pad(1,wait=.6);bursts+=1
             observed=counts(c,label+'_after_burst_'+str(bursts))
+            expected=min(6,previous)
+            # 40928's sixth original shot arrived 16.1703ms after this first
+            # typed sample. A partial observation is not a terminal result.
+            # Wait for THIS same real burst only, inside the unchanged whole
+            # drain deadline. Never issue another press to finish it.
+            completion_samples=[observed]
+            evidence.setdefault('completion_observations',[]).append(completion_samples)
